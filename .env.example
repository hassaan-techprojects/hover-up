# Gmail sender used for Hover Up account verification and password recovery
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Optional; defaults to GMAIL_USER
GMAIL_FROM=your-sender@gmail.com

# Use a unique random secret (32+ characters) for OTP hashing
OTP_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Existing authentication secret is also required by NextAuth
NEXTAUTH_SECRET=replace-with-your-existing-nextauth-secret
