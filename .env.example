# Database connections: use the pooled URL for app requests and the direct URL for Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Gmail sender used for Hover Up account verification and password recovery.
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
# Display name shown in the recipient's inbox.
GMAIL_FROM="Hover Up"

# Use a unique random secret (32+ characters) for OTP hashing.
OTP_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Existing authentication secret is also required by NextAuth.
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_URL=http://localhost:3000
